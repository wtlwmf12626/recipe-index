    {
      "id": "r001",
      "name": "Garlic Butter Pasta",
      "source": "Family recipe",
      "sourceUrl": null,
      "dateAdded": "2026-04-01",
      "mealType": ["dinner"],
      "cuisine": ["Italian"],
      "protein": ["vegetarian"],
      "effort": "quick",
      "status": "made",
      "favorite": true,
      "servings": 4,
      "prepTime": "5 min",
      "cookTime": "15 min",
      "ingredients": [
        { "name": "spaghetti", "qty": 1, "unit": "lb", "pantryKey": "spaghetti" },
        { "name": "butter", "qty": 4, "unit": "tbsp", "pantryKey": "butter" },
        { "name": "garlic cloves, minced", "qty": 6, "unit": "", "pantryKey": "garlic" },
        { "name": "parmesan cheese, grated", "qty": 0.5, "unit": "cup", "pantryKey": "parmesan" },
        { "name": "fresh parsley, chopped", "qty": 2, "unit": "tbsp", "pantryKey": "parsley" }
      ],
      "instructions": [
        "Bring a large pot of salted water to a boil. Cook spaghetti according to package directions until al dente. Reserve 1 cup of pasta water before draining.",
        "While pasta cooks, melt butter in a large skillet over medium heat. Add minced garlic and cook for 1-2 minutes until fragrant but not browned.",
        "Add drained pasta to the skillet and toss with the garlic butter. Add pasta water a few tablespoons at a time until you get a light sauce.",
        "Remove from heat, toss with parmesan and parsley. Season with salt and pepper to taste. Serve immediately."
      ],
      "notes": "Dead simple weeknight meal. Add red pepper flakes for heat. Works great with any pasta shape."
    },
    {
      "id": "r002",
      "name": "Chicken Parmesan",
      "source": "Mom's recipe card",
      "sourceUrl": null,
      "dateAdded": "2026-04-01",
      "mealType": ["dinner"],
      "cuisine": ["Italian"],
      "protein": ["chicken"],
      "effort": "moderate",
      "status": "made",
      "favorite": true,
      "servings": 4,
      "prepTime": "20 min",
      "cookTime": "30 min",
      "ingredients": [
        { "name": "chicken breast", "qty": 2, "unit": "lbs", "pantryKey": "chicken-breast" },
        { "name": "breadcrumbs", "qty": 1, "unit": "cup", "pantryKey": "breadcrumbs" },
        { "name": "eggs", "qty": 2, "unit": "", "pantryKey": "eggs" },
        { "name": "marinara sauce", "qty": 2, "unit": "cups", "pantryKey": "marinara-sauce" },
        { "name": "mozzarella cheese, shredded", "qty": 1.5, "unit": "cups", "pantryKey": "mozzarella" },
        { "name": "parmesan cheese, grated", "qty": 0.5, "unit": "cup", "pantryKey": "parmesan" },
        { "name": "olive oil", "qty": 3, "unit": "tbsp", "pantryKey": "olive-oil" },
        { "name": "garlic powder", "qty": 1, "unit": "tsp", "pantryKey": "garlic-powder" },
        { "name": "salt and pepper", "qty": 1, "unit": "", "pantryKey": "salt" }
      ],
      "instructions": [
        "Preheat oven to 425°F. Slice chicken breasts in half horizontally to make thin cutlets. Season with salt, pepper, and garlic powder.",
        "Set up a breading station: beaten eggs in one shallow dish, breadcrumbs in another. Dip each cutlet in egg, then coat in breadcrumbs.",
        "Heat olive oil in an oven-safe skillet over medium-high heat. Sear chicken cutlets 3-4 minutes per side until golden brown.",
        "Spoon marinara sauce over each cutlet, then top with mozzarella and parmesan.",
        "Transfer skillet to oven and bake 15-20 minutes until cheese is melted and bubbly and chicken reaches 165°F internally.",
        "Let rest 5 minutes before serving. Great with spaghetti or a green salad."
      ],
      "notes": "Double the sauce — kids love extra for dipping. Can bread the chicken ahead of time and refrigerate."
    },
    {
      "id": "r003",
      "name": "Thai Basil Chicken Stir Fry",
      "source": "Food blog",
      "sourceUrl": "https://example.com/thai-basil-chicken",
      "dateAdded": "2026-04-01",
      "mealType": ["dinner"],
      "cuisine": ["Asian"],
      "protein": ["chicken"],
      "effort": "quick",
      "status": "to-try",
      "favorite": false,
      "servings": 4,
      "prepTime": "10 min",
      "cookTime": "10 min",
      "ingredients": [
        { "name": "ground chicken", "qty": 1.5, "unit": "lbs", "pantryKey": "ground-chicken" },
        { "name": "Thai basil leaves", "qty": 1, "unit": "cup", "pantryKey": "thai-basil" },
        { "name": "garlic cloves, minced", "qty": 4, "unit": "", "pantryKey": "garlic" },
        { "name": "soy sauce", "qty": 2, "unit": "tbsp", "pantryKey": "soy-sauce" },
        { "name": "fish sauce", "qty": 1, "unit": "tbsp", "pantryKey": "fish-sauce" },
        { "name": "brown sugar", "qty": 1, "unit": "tbsp", "pantryKey": "brown-sugar" },
        { "name": "vegetable oil", "qty": 2, "unit": "tbsp", "pantryKey": "vegetable-oil" },
        { "name": "jasmine rice, cooked", "qty": 4, "unit": "cups", "pantryKey": "rice" }
      ],
      "instructions": [
        "Heat oil in a wok or large skillet over high heat until smoking.",
        "Add garlic and stir fry 30 seconds until fragrant.",
        "Add ground chicken, breaking it up with a spatula. Cook 5-6 minutes until cooked through and starting to crisp.",
        "Add soy sauce, fish sauce, and brown sugar. Stir to combine and cook 1 minute.",
        "Remove from heat, stir in Thai basil leaves until just wilted.",
        "Serve over jasmine rice."
      ],
      "notes": ""
    },
    {
      "id": "r004",
      "name": "Sheet Pan Lemon Herb Salmon",
      "source": "Magazine clipping",
      "sourceUrl": null,
      "dateAdded": "2026-04-01",
      "mealType": ["dinner"],
      "cuisine": ["American"],
      "protein": ["fish"],
      "effort": "quick",
      "status": "made",
      "favorite": false,
      "servings": 4,
      "prepTime": "10 min",
      "cookTime": "20 min",
      "ingredients": [
        { "name": "salmon fillets", "qty": 4, "unit": "", "pantryKey": "salmon" },
        { "name": "asparagus, trimmed", "qty": 1, "unit": "bunch", "pantryKey": "asparagus" },
        { "name": "lemon", "qty": 1, "unit": "", "pantryKey": "lemon" },
        { "name": "olive oil", "qty": 3, "unit": "tbsp", "pantryKey": "olive-oil" },
        { "name": "dried dill", "qty": 1, "unit": "tsp", "pantryKey": "dill" },
        { "name": "garlic powder", "qty": 1, "unit": "tsp", "pantryKey": "garlic-powder" },
        { "name": "salt and pepper", "qty": 1, "unit": "", "pantryKey": "salt" }
      ],
      "instructions": [
        "Preheat oven to 400°F. Line a sheet pan with parchment paper.",
        "Arrange salmon fillets in the center and asparagus around them. Drizzle everything with olive oil.",
        "Season salmon with dill, garlic powder, salt, and pepper. Squeeze half the lemon over everything and slice the other half into rounds to place on top of the fish.",
        "Roast 18-20 minutes until salmon flakes easily with a fork and asparagus is tender-crisp.",
        "Serve immediately with extra lemon wedges."
      ],
      "notes": "Swap asparagus for broccoli or green beans depending on the season. Works with any firm fish."
    },
    {
      "id": "r005",
      "name": "Classic Banana Bread",
      "source": "Grandma's recipe",
      "sourceUrl": null,
      "dateAdded": "2026-04-01",
      "mealType": ["breakfast", "snack", "dessert"],
      "cuisine": ["American"],
      "protein": ["vegetarian"],
      "effort": "moderate",
      "status": "made",
      "favorite": true,
      "servings": 10,
      "prepTime": "15 min",
      "cookTime": "55 min",
      "ingredients": [
        { "name": "ripe bananas, mashed", "qty": 3, "unit": "", "pantryKey": "bananas" },
        { "name": "butter, melted", "qty": 0.33, "unit": "cup", "pantryKey": "butter" },
        { "name": "sugar", "qty": 0.75, "unit": "cup", "pantryKey": "sugar" },
        { "name": "egg", "qty": 1, "unit": "", "pantryKey": "eggs" },
        { "name": "vanilla extract", "qty": 1, "unit": "tsp", "pantryKey": "vanilla" },
        { "name": "baking soda", "qty": 1, "unit": "tsp", "pantryKey": "baking-soda" },
        { "name": "all-purpose flour", "qty": 1.5, "unit": "cups", "pantryKey": "flour" },
        { "name": "salt", "qty": 1, "unit": "pinch", "pantryKey": "salt" }
      ],
      "instructions": [
        "Preheat oven to 350°F. Grease a 9x5 inch loaf pan.",
        "Mash bananas in a large bowl until smooth. Mix in melted butter.",
        "Stir in sugar, beaten egg, and vanilla extract.",
        "Sprinkle baking soda and salt over the mixture, then stir in. Gently fold in flour until just combined — do not overmix.",
        "Pour batter into prepared pan. Bake 55-60 minutes until a toothpick inserted in the center comes out clean.",
        "Cool in the pan for 10 minutes, then transfer to a wire rack."
      ],
      "notes": "The riper the bananas the better — fully brown/black ones are ideal. Add chocolate chips or walnuts if you want."
    }
